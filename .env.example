# ===================================================
# Variables de Entorno del Sistema de Conciliación
# Copia este archivo a '.env' en la raíz de tu proyecto
# ===================================================

# Conexión a la base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conciliacion?schema=public"

# Clave secreta para firma y verificación de JWT (Autenticación y RBAC)
JWT_SECRET="super-secret-key-conciliacion-jwt-auth-2026-secure-token"
