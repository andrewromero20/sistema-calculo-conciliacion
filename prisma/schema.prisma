// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER_SE
  USER_PT
  ADMIN
}

model Usuario {
  id             Int           @id @default(autoincrement())
  nombre         String
  email          String        @unique
  password       String
  rol            Role          @default(USER_SE)
  fechaCreacion  DateTime      @default(now())
  registrosSE    RegistroSE[]
  auditoriasSE   AuditoriaSE[]
}

model RegistroSE {
  ordenGranel                String        @id
  lote                       String        @unique
  codigoMaterial             String
  producto                   String
  tamanoLoteEstandar         Decimal
  supervisorPreparacion      String
  supervisorTabRecub         String
  pesoNetoTotalTabletas      Decimal
  pesoPromedio               Decimal
  cantPzasCargarSap          Decimal
  cantPzasAcondicionar       Decimal
  muestrasTabRecub           Decimal
  rendimientoTab             Decimal
  ctecGranelSap              String
  fechaInicioTableteado      DateTime
  fechaFinTableteado         DateTime
  fechaInicioRecubrimiento   DateTime
  fechaFinPrimeraCarga       DateTime
  fechaFinRecubrimiento      DateTime
  
  creadoPorId                Int
  creadoPor                  Usuario       @relation(fields: [creadoPorId], references: [id])
  fechaCreacion              DateTime      @default(now())
  pesos                      PesoSE[]
  auditorias                 AuditoriaSE[]
  conciliaciones             Conciliacion[]
}

model PesoSE {
  id               Int        @id @default(autoincrement())
  registroSeOrden  String
  registroSE       RegistroSE @relation(fields: [registroSeOrden], references: [ordenGranel], onDelete: Cascade)
  pesoBruto        Decimal
  pesoTara         Decimal
  pesoNeto         Decimal
}

model AuditoriaSE {
  id                Int        @id @default(autoincrement())
  registroSeOrden   String
  registroSE        RegistroSE @relation(fields: [registroSeOrden], references: [ordenGranel], onDelete: Cascade)
  usuarioId         Int
  usuario           Usuario    @relation(fields: [usuarioId], references: [id])
  fechaModificacion DateTime   @default(now())
  cambios           Json
  justificacion     String     @db.Text
}

model Conciliacion {
  id                 Int               @id @default(autoincrement())
  numeroOrden        String            @unique
  ordenGranel        String?
  registroSE         RegistroSE?       @relation(fields: [ordenGranel], references: [ordenGranel])
  estadoConciliacion String
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt
  materiales         Material[]
  historialCambios   HistorialCambio[]
}

model Material {
  id Int @id @default(autoincrement())

  descripcion String
  codigoSAP   String
  numeroOrden String

  unidadMedida String

  blisterPorCaja     Int?
  tabletasPorBlister Int?

  cantidadRealAcondicionada Float?
  capacidadCajaEmpaque     Float?

  cantidadSurtidaA   Float?
  cantidadAdicionalB Float?
  cantidadDevueltaC  Float?

  telecamara    Float?
  hermeticidad  Float?
  otraMerma     Float?
  cajasTomadasMuestra     Float?
  cajasUtilizadasArranque Float?

  totalRecibidaD Float?

  resultadoE Float?
  resultadoF Float?
  resultadoG Float?

  totalUtilizadaH Float?

  diferencia           Float?
  porcentajeDiferencia Float?

  limitePermitido Float?

  estadoMaterial String?

  conciliacionId Int
  conciliacion   Conciliacion @relation(fields: [conciliacionId], references: [id])
}

model HistorialCambio {
  id Int @id @default(autoincrement())

  accion          String
  campoModificado String?

  valorAnterior String?
  valorNuevo    String?

  usuario String

  fechaHora DateTime @default(now())

  conciliacionId Int
  conciliacion   Conciliacion @relation(fields: [conciliacionId], references: [id])
}
